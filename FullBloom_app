  .stepdots{display:flex;gap:6px;justify-content:center;margin-bottom:8px;}
  .stepdots i{width:7px;height:7px;border-radius:50%;background:var(--line);}
  .stepdots i.on{background:var(--rose);}
  .hint{background:rgba(217,180,94,.1); border:1px solid rgba(217,180,94,.3); border-radius:12px; padding:10px 13px; margin:10px 0; font-size:14px; color:var(--gold-soft);}
  .fb{background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:11px 13px; margin:8px 0; font-size:14px;}
  .fb .w{color:#e39a9a; font-weight:700;}
</style>
</head>
