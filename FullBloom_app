function poolById(id){return POOL.find(p=>p.id===id);}
function buildRecord(){return {alias:state.alias,lang:state.lang,startedAt:state.startedAt,finishedAt:state.finishedAt,
  act1:{selected:state.act1.selected,priorities:state.act1.priorities,candidate:state.act1.candidate},
  act2:{ranking:state.act2.ranking,enfoque:state.act2.enfoque,neglected:state.act2.neglected},
  act3:state.act3,timeouts:state.timeouts};}
async function syncToSheet(){if(!CONFIG.sheetEndpoint)return;try{await fetch(CONFIG.sheetEndpoint,{method:"POST",mode:"no-cors",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(buildRecord())});}catch(e){}}

function fmt(s){return `${String(Math.floor(s/60)).padStart(2,"0")}:${String(Math.max(0,s%60)).padStart(2,"0")}`;}
function startTimer(sec,onEnd){if(cancelTimer)cancelTimer();let left=sec;timerEl.classList.remove("hidden");timerEl.textContent=fmt(left);
  const id=setInterval(()=>{left--;timerEl.textContent=fmt(left);if(left<=0){clearInterval(id);cancelTimer=null;onEnd&&onEnd();}},1000);
  cancelTimer=()=>{clearInterval(id);timerEl.classList.add("hidden");cancelTimer=null;};}
function armDelib(btn,sec){const base=btn.dataset.base||btn.textContent;btn.dataset.base=base;
  if(sec<=0){btn.dataset.delib="done";if(btn.dataset.ready==="1")btn.disabled=false;return;}
  btn.disabled=true;let left=sec;btn.textContent=`${base} (${left}s)`;
  const id=setInterval(()=>{left--;if(left<=0){clearInterval(id);btn.textContent=base;btn.dataset.delib="done";if(btn.dataset.ready==="1")btn.disabled=false;}else btn.textContent=`${base} (${left}s)`;},1000);}
function render(html,opts){opts=opts||{};topBar.style.visibility=opts.top?"visible":"hidden";
  if(!opts.timer&&cancelTimer)cancelTimer();if(!opts.timer)timerEl.classList.add("hidden");
  app.innerHTML='<div class="screen">'+html+'</div>';try{window.scrollTo(0,0);}catch(e){}}
function cta(inner){return `<div class="cta-wrap"><div class="cta-inner">${inner}</div></div>`;}
