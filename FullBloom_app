const app=document.getElementById("app"), topBar=document.getElementById("top"), timerEl=document.getElementById("timer");
let cancelTimer=null;
function clone(o){return JSON.parse(JSON.stringify(o));}
function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
function save(){try{localStorage.setItem("fullbloom2",JSON.stringify(state));}catch(e){}}
