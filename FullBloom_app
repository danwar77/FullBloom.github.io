/* --- ACTO 1B · entrevista / escape room --- */
function getOptions(pz){
  if(pz.options) return {multi:!!pz.multi, options:pz.options.map(o=>({text:o.text,correct:!!o.correct,why:o.why||"",near:o.near||""}))};
  return {multi:false, options:[{text:pz.good,correct:true,why:"",near:""}].concat((pz.weak||[]).map(w=>({text:w[0],correct:false,why:w[1],near:""})))};
}
function screenPuzzle(){
  const prios=state.act1.priorities.filter(id=>PUZZLES[id]);
  if(state.act1.puzzleIdx>=prios.length){ syncToSheet(); return screenCandidates(); }
  const compId=prios[state.act1.puzzleIdx], comp=poolById(compId);
  const cfg=getOptions(PUZZLES[compId]), opts=cfg.options, multi=cfg.multi;
  const order=opts.map((_,i)=>i);
  for(let i=order.length-1;i>0;i--){const j=(i+state.act1.puzzleIdx*7+3)%(i+1);[order[i],order[j]]=[order[j],order[i]];}
  const correctSet=opts.map((o,i)=>o.correct?i:-1).filter(i=>i>=0);
  render(`<div class="stepdots">${prios.map((_,i)=>`<i class="${i<=state.act1.puzzleIdx?'on':''}"></i>`).join("")}</div>
   <p class="eyebrow">Acto 1 · Fase B · La entrevista</p>
   <h2>${esc(comp.name)}</h2>
   <p class="lead">${multi?"Hay <b>más de una</b> pregunta que detecta esta competencia. Marcad todas las que la detecten y descartad el resto.":"¿Cuál de estas preguntas <b>detecta de verdad</b> esta competencia? Descarta las que no y quédate con una."}</p>
   <div class="grid" id="pz">${order.map((k,pos)=>`<button class="opt" data-k="${k}"><span class="${multi?'box':'letter'}">${multi?'':"ABCDE"[pos]}</span><span class="txt">${esc(opts[k].text)}</span></button>`).join("")}</div>
   <div id="fbarea"></div>
   ${cta(`<button class="cta" id="pzc" disabled>Confirmar</button>`)}`,{top:true,timer:true});
  if(state.act1.puzzleIdx===0) startTimer(CONFIG.timers.act1,()=>{});
  const btn=document.getElementById("pzc"); let picks=[];
  const fb=(h)=>document.getElementById("fbarea").innerHTML=`<div class="fb">${h}</div>`;
  function advance(){app.querySelectorAll("#pz .opt").forEach(x=>x.classList.add("disabled"));btn.textContent="Siguiente";btn.disabled=false;btn.onclick=()=>{state.act1.puzzleIdx++;save();screenPuzzle();};}
  app.querySelectorAll("#pz .opt").forEach(o=>o.onclick=()=>{
    if(o.classList.contains("bad")||o.classList.contains("disabled"))return;
    const k=parseInt(o.dataset.k);
    if(multi){const i=picks.indexOf(k);if(i>=0){picks.splice(i,1);o.classList.remove("sel");}else{picks.push(k);o.classList.add("sel");}btn.disabled=picks.length===0;}
    else{picks=[k];app.querySelectorAll("#pz .opt").forEach(x=>x.classList.toggle("sel",x===o));btn.disabled=false;}
  });
  btn.onclick=()=>{
    if(!picks.length)return;
    if(multi){
      const wrong=picks.filter(k=>!opts[k].correct), missing=correctSet.filter(k=>!picks.includes(k));
      if(wrong.length){wrong.forEach(k=>{const el=app.querySelector(`[data-k="${k}"]`);el.classList.add("bad");el.classList.remove("sel");});picks=picks.filter(k=>opts[k].correct);
        fb(`<span class="w">Esa no.</span> ${esc(opts[wrong[0]].why)}`);btn.disabled=picks.length===0;}
      else if(missing.length){fb(`<span class="w">Casi.</span> Hay más de una pregunta que detecta esta competencia: falta al menos una.`);}
      else{picks.forEach(k=>app.querySelector(`[data-k="${k}"]`).classList.add("good"));fb(`<b style="color:var(--green)">Así se detecta.</b> Las conductuales concretas revelan conducta real.`);advance();}
    } else {
      const k=picks[0], o=opts[k], el=app.querySelector(`[data-k="${k}"]`);
      if(o.correct){el.classList.add("good");fb(`<b style="color:var(--green)">Así se detecta.</b> Pide un caso concreto —conducta real, no una opinión.`);advance();}
      else if(o.near){el.classList.remove("sel");el.classList.add("disabled");fb(`<b style="color:var(--gold)">${esc(o.near)}</b>`);picks=[];btn.disabled=true;}
      else{el.classList.add("bad");el.classList.remove("sel");state.act1.puzzleErrors[compId]=(state.act1.puzzleErrors[compId]||0)+1;save();fb(`<span class="w">Esa no.</span> ${esc(o.why)} Sigue buscando la que pide un ejemplo concreto.`);picks=[];btn.disabled=true;}
    }
  };
}
