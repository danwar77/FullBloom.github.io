  render(`<p class="eyebrow">Acto 2 · El plan de onboarding</p><h1>Habéis contratado a ${esc(c.name)}</h1>
   <p class="lead">Tiene mucho potencial y buenas fortalezas, pero también oportunidades de desarrollo. En la siguiente lista encontraréis los requisitos que decidisteis al inicio y que ${esc(c.name)} no cumple al 100%:</p>
   <div class="block">${gaps.map(g=>`<div class="chk no"><span class="b no">☐</span><span>${esc(g)}</span></div>`).join("")}</div>
   <p class="lead">Con esta lista en mente, hay que preparar su plan de onboarding.</p>
   ${cta(`<button class="cta" id="d">Planificar su onboarding</button>`)}`,{top:true,timer:true});
  startTimer(CONFIG.timers.act2,()=>{ if(state.act2.ranking.length===4) finishAct2(); });
  document.getElementById("d").onclick=()=>screenRanking();
}
function screenRanking(){
  render(`<p class="eyebrow">Acto 2 · Prioriza</p><h1>¿En qué os centráis primero?</h1>
   <p class="lead">Como Store Manager, no vais a poder desarrollar todas las áreas de oportunidad al mismo tiempo, así que debéis decidir en cuál es prioritario centrarse en las primeras semanas, para que ese talento florezca. Ordenad las 4 dimensiones del onboarding según lo que sea más necesario trabajar con <b>${esc(cand().name)}</b> (1 = lo más importante y urgente).</p>
   <div class="grid" id="rk">${DIMENSIONS.map(d=>`<button class="opt" data-id="${d.id}"><span class="rank" style="visibility:hidden">·</span><span class="txt">${esc(d.label)}</span></button>`).join("")}</div>
   ${cta(`<button class="cta" id="rc" disabled>Confirmar prioridades</button>`)}`,{top:true,timer:true});
  let picks=[];const btn=document.getElementById("rc");
  app.querySelectorAll("#rk .opt").forEach(o=>o.onclick=()=>{const id=o.dataset.id,i=picks.indexOf(id);
    if(i>=0)picks.splice(i,1);else if(picks.length<4)picks.push(id);
    app.querySelectorAll("#rk .opt").forEach(x=>{const r=picks.indexOf(x.dataset.id),rk=x.querySelector(".rank");
      if(r>=0){x.classList.add("sel");rk.style.visibility="visible";rk.textContent=r+1;}else{x.classList.remove("sel");rk.style.visibility="hidden";}});
    btn.disabled=picks.length!==4;});
  btn.onclick=()=>{state.act2.ranking=picks.slice();state.act2.neglected=picks[3];save();screenEnfoque(0);};
}
function screenEnfoque(i){
  const top=state.act2.ranking.slice(0,3);
  if(i>=top.length){ save();return finishAct2(); }
  const d=DIMENSIONS.find(x=>x.id===top[i]);
  render(`<div class="stepdots">${top.map((_,k)=>`<i class="${k<=i?'on':''}"></i>`).join("")}</div>
   <p class="eyebrow">Acto 2 · Diseña el enfoque · prioridad ${i+1}</p><h2>${esc(d.label)}</h2>
   <p class="lead">¿Cómo lo planificáis para ${esc(cand().name)}?</p>
   <div class="grid" id="en">
     <button class="opt" data-v="intencional"><span class="box"></span><span class="txt">${esc(d.intencional)}</span></button>
     <button class="opt" data-v="atajo"><span class="box"></span><span class="txt">${esc(d.atajo)}</span></button>
   </div>${cta(`<button class="cta" id="ec" disabled>Confirmar</button>`)}`,{top:true,timer:true});
  let pick=null;const btn=document.getElementById("ec");
  app.querySelectorAll("#en .opt").forEach(o=>o.onclick=()=>{pick=o.dataset.v;app.querySelectorAll("#en .opt").forEach(x=>x.classList.toggle("sel",x===o));btn.disabled=false;});
  btn.onclick=()=>{state.act2.enfoque[d.id]=pick;save();screenEnfoque(i+1);};
}
function finishAct2(){if(cancelTimer)cancelTimer();syncToSheet();screenReveal();}
function screenReveal(){
  const atajos=Object.keys(state.act2.enfoque).filter(k=>state.act2.enfoque[k]==="atajo").map(k=>DIMENSIONS.find(d=>d.id===k));
  const neg=DIMENSIONS.find(d=>d.id===state.act2.neglected);
  let html=`<p class="eyebrow">Antes del mundo real</p><h1>Lo que vuestro plan deja expuesto</h1>`;
  if(atajos.length){html+=`<p class="lead">Tomasteis algún atajo:</p>`+atajos.map(d=>`<div class="block"><div class="role roleB">${esc(d.label)} — el atajo</div><i>${esc(d.mensaje)}</i></div>`).join("");}
  else{html+=`<p class="lead">No tomasteis atajos en vuestras prioridades. Bien.</p>`;}
  html+=`<div class="block" style="border-color:var(--rose)"><div class="role roleA">El flanco descubierto</div>Dejasteis <b>${esc(neg.label)}</b> en último lugar. Eso es justo lo que no preparasteis… y lo que puede pasaros factura ahora.</div>`;
  html+=cta(`<button class="cta" id="rc2">Ir al mundo real</button>`);
  render(html,{top:true});
  document.getElementById("rc2").onclick=()=>routeShadow();
}
/* --- ACTO 3 --- */
function exposedShadows(){
  const c=cand();const amp=SHADOW_MAP[state.act2.neglected]||[];
  const exposed=c.shadows.filter(s=>amp.includes(s));
  return exposed.length?exposed:[c.shadows[0]]; // si ninguna coincide -> sombra dominante
}
function routeShadow(){
  const ex=exposedShadows();
  if(ex.length===1){state.act3.shadow=ex[0];save();return screenCase();}
  // varias -> el equipo prioriza cuál trabajar primero
  render(`<p class="eyebrow">Acto 3 · El mundo real</p><h1>Emergieron varias sombras</h1>
   <p class="lead">El flanco que dejasteis en <b>${esc(DIMENSIONS.find(d=>d.id===state.act2.neglected).label)}</b> destapó más de una. ¿Cuál trabajáis <b>primero</b>?</p>
   <div class="grid" id="sh">${ex.map(s=>`<button class="opt" data-s="${s}"><span class="box"></span><span class="txt">${esc(shadowLabel(s))}</span></button>`).join("")}</div>
   ${cta(`<button class="cta" id="shc" disabled>Afrontar esta</button>`)}`,{top:true});
  let pick=null;const btn=document.getElementById("shc");
  app.querySelectorAll("#sh .opt").forEach(o=>o.onclick=()=>{pick=o.dataset.s;app.querySelectorAll("#sh .opt").forEach(x=>x.classList.toggle("sel",x===o));btn.disabled=false;});
  btn.onclick=()=>{state.act3.shadow=pick;save();screenCase();};
}
function shadowLabel(s){const c=CHALLENGES[s];const m={crecer:"Impaciencia por los resultados",conexion:"Amiguismo, evita el conflicto",actitud:"Aguanta y se aísla en silencio",energia:"Necesita protagonismo",cumple:"Rigidez ante el cambio",aprende:"Se dispersa, se aburre con la rutina",experiencias:"Se sobre-implica, regala de más",rol:"Va por libre",detalle:"Perfeccionismo que frena"};return m[s]+" ("+c.prot+")";}
function screenCase(){
  const ch=CHALLENGES[state.act3.shadow];const c=cand();
  render(`<p class="eyebrow">Acto 3 · El mundo real</p>
   <p class="muted" style="margin:-2px 0 10px">Han pasado varios meses. La sombra que traía ${esc(c.name)} se hizo visible.</p>
   <p class="lead">${esc(ch.esc)}</p>
   <div class="grid" id="co">${ch.opts.map(o=>`<button class="opt" data-o="${o[0]}"><span class="letter">${o[0]}</span><span class="txt">${esc(o[1])}</span></button>`).join("")}</div>
   ${cta(`<button class="cta" id="cc3">Registrar decisión</button>`)}`,{top:true,timer:true});
  startTimer(CONFIG.timers.act3,()=>finishCase());
  let pick=null;const btn=document.getElementById("cc3");armDelib(btn,CONFIG.deliberationMin.act3case);btn.dataset.ready="0";
  app.querySelectorAll("#co .opt").forEach(o=>o.onclick=()=>{pick=o.dataset.o;app.querySelectorAll("#co .opt").forEach(x=>x.classList.toggle("sel",x===o));btn.dataset.ready="1";if(btn.dataset.delib==="done")btn.disabled=false;});
  btn.onclick=()=>{if(!pick)return;state.act3.choice=pick;finishCase();};
}
function finishCase(){if(cancelTimer)cancelTimer();state.finishedAt=new Date().toISOString();save();syncToSheet();screenClose();}
function screenClose(){
  const c=cand();const neg=DIMENSIONS.find(d=>d.id===state.act2.neglected);
  render(`<div class="hero">${bloomSvg(54)}</div>
   <p class="eyebrow center">Fin de la partida</p><h1 class="center">Lo construisteis vosotros</h1>
   <div class="block"><div class="role roleA">Contratasteis a</div><b>${esc(c.name)} · ${c.age}</b><br><span class="muted">${esc(c.destaca)}</span></div>
   <div class="block"><div class="role roleB">Descuidasteis</div>${esc(neg.label)}</div>
   <p class="lead">El reto que resolvisteis no fue al azar: nació de la sombra que traía quien elegisteis y del flanco que dejasteis sin preparar. La coherencia entre lo que sembráis al inicio y lo que hacéis bajo presión —eso es liderazgo.</p>
   <p class="quote">${esc(CONFIG.tagline)}</p>
   <p class="center muted">Podéis tomar una captura antes de terminar.</p><hr class="hr">
   ${cta(`<button class="cta ghost" id="rs">Nueva partida</button>`)}`,{top:true});
  document.getElementById("rs").onclick=resetGame;
}
/* --- reanudar --- */
function boot(){
  const s=load();
  if(s&&s.screen&&s.screen!=="lang"&&!s.finishedAt&&s.alias){
    state=s;
    render(`<div class="hero" style="margin-top:40px">${bloomSvg(48)}</div><h1 class="center">¿Reanudar la partida?</h1>
     <p class="lead center">Hay una sesión sin terminar del equipo <b>${esc(s.alias)}</b>.</p>
     ${cta(`<button class="cta" id="res">Reanudar</button><button class="cta ghost" id="new" style="margin-top:10px">Empezar de nuevo</button>`)}`,{});
    document.getElementById("res").onclick=()=>resume();
    document.getElementById("new").onclick=resetGame;
  } else screenLang();
}
function resume(){
  const a1=state.act1,a2=state.act2,a3=state.act3;
  if(a3.shadow) return screenCase();
  if(a2.neglected) return screenReveal();
  if(a2.ranking&&a2.ranking.length) return screenEnfoque(0);
  if(a1.candidate) return screenAct2Diag();
  if(a1.priorities&&a1.priorities.length) return screenPuzzle();
  if(a1.selected&&a1.selected.length) return screenPriorities();
  if(state.alias) return screenReq();
  return screenWelcome();
}
boot();
</script>
