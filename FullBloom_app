  .think .q{font-family:var(--serif); font-style:italic; font-size:16px;}
  .persona .nm{font-family:var(--serif); font-size:24px; font-weight:700;}
  .persona .bd{color:var(--gold-soft); font-size:13px; margin-bottom:8px;}
  .chk{display:flex; gap:9px; align-items:flex-start; margin:5px 0; font-size:14.5px;}
  .chk .b{font-weight:800; font-size:15px;}
  .chk .yes{color:var(--green);} .chk .no{color:var(--ink-mute);}
  .chk.no span{color:var(--ink-mute);}
  .hero{display:flex; justify-content:center; margin:10px 0 14px;}
  .quote{font-family:var(--serif); font-style:italic; font-size:18px; line-height:1.4; color:var(--gold-soft);
    border-left:3px solid var(--gold); padding:2px 0 2px 15px; margin:14px 0;}
  .center{text-align:center;} .hr{height:1px;background:var(--line);border:0;margin:16px 0;}
  .pill{display:inline-block; font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:#241a05; background:var(--gold);
